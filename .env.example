# Copy this file to .env and fill in your own values.
# Never commit the real .env to version control.

# Django Settings
# Generate on the server: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (PostgreSQL URL: postgres://USER:PASSWORD@HOST:PORT/DB_NAME)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB_NAME

# Admin panel URL path (keep this non-obvious)
ADMIN_URL_PATH=change-me-admin-path

# Email: the Hostinger Mail box that sends enquiry emails (smtp.hostinger.com, port 465)
EMAIL_HOST_USER=support@desiroots.co.uk
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
NOTIFICATION_EMAIL=

# Cloudflare Turnstile Keys (Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry DSN (Optional, production only)
SENTRY_DSN=
